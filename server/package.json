{
  "name": "hireme-api",
  "version": "1.0.0",
  "description": "HireMe API: startups meet developers",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=../.env --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --env-file-if-exists=../.env --watch-path=src --disable-warning=ExperimentalWarning src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "demo": "DB_PATH=./data/demo.db node --disable-warning=ExperimentalWarning scripts/demo.js"
  },
  "license": "ISC",
  "dependencies": {
    "express": "^5.3.0",
    "nodemailer": "^10.6.1",
    "playwright": "^1.65.1",
    "unpdf": "^1.9.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
