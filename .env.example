# Copy to .env for local runs. In production set these as secrets on your host.

# The public address people use, no trailing slash. Used in emails and for secure cookies.
PUBLIC_URL=http://localhost:4317

# Who approves startups and sees reports (comma-separated). Sign in with one of these to get the Admin tab.
ADMIN_EMAILS=you@example.com

# Email for sign-in links and match notifications. Any SMTP provider works, e.g.
#   smtps://resend:<API_KEY>@smtp.resend.com:465
#   smtps://<user>:<app-password>@smtp.gmail.com:465
# Without it (local only), sign-in links are printed in the server log and shown on screen.
SMTP_URL=
# The password can go in the URL or separately here (e.g. a Gmail app password):
SMTP_PASS=
MAIL_FROM=HireMe <hello@example.com>

# PORT=4317
# DB_PATH=./data/hireme.db
