# Copy to .env and fill in what you need.

# Claude writes tailored resumes, cover letters, gap questions and form answers.
# Without it, Sprout uses templates and your uploaded resume.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# To swipe from your phone on the same Wi-Fi: listen on the network and set an access code.
# HOST=0.0.0.0
# SPROUT_TOKEN=pick-a-long-code

# PORT=4317
# DB_PATH=./data/sprout.db

# Apply agent
# AGENT=off                # disable automatic applying
# CHROME_PATH=/path/to/chrome   # use an installed Chrome instead of Playwright's Chromium
# AGENT_HEADLESS=false     # watch the browser while it applies
